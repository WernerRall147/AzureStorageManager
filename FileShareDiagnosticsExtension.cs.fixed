using System;
using System.Threading.Tasks;
using AzureStorageManager.Services;
using AzureStorageManager.Utilities;

namespace AzureStorageManager
{
    public partial class Program
    {
        /// <summary>
        /// Runs permissions diagnostics on an Azure File Share
        /// </summary>
        private static async Task RunFileSharePermissionDiagnostics()
        {
            Console.Clear();
            Console.WriteLine("=== Azure File Share Permission Diagnostics ===\n");
            Console.WriteLine("This tool will test various operations on your Azure File Share to identify");
            Console.WriteLine("which specific permissions you have and which ones are missing.");
            Console.WriteLine("It helps diagnose 'Access Denied' errors when working with File Shares.\n");
            
            try
            {
                // Get storage account information
                Console.WriteLine("[INFO] Getting storage account information...");
                
                string storageAccountName = Models.ConnectionState.StorageAccountName ?? "";
                if (string.IsNullOrEmpty(storageAccountName))
                {
                    Console.Write("Enter your Azure Storage Account Name: ");
                    storageAccountName = Console.ReadLine() ?? "";
                    if (string.IsNullOrEmpty(storageAccountName))
                    {
                        Console.ForegroundColor = ConsoleColor.Red;
                        Console.WriteLine("[ERROR] Storage account name is required to run diagnostics.");
                        Console.ResetColor();
                        return;
                    }
                }
                else
                {
                    Console.WriteLine($"[INFO] Using storage account: {storageAccountName}");
                }
                
                // Get file share name
                string fileShareName = Models.ConnectionState.FileShareName ?? "";
                if (string.IsNullOrEmpty(fileShareName))
                {
                    Console.Write("Enter your Azure File Share Name: ");
                    fileShareName = Console.ReadLine() ?? "";
                    if (string.IsNullOrEmpty(fileShareName))
                    {
                        Console.ForegroundColor = ConsoleColor.Red;
                        Console.WriteLine("[ERROR] File share name is required to run diagnostics.");
                        Console.ResetColor();
                        return;
                    }
                }
                else
                {
                    Console.WriteLine($"[INFO] Using file share: {fileShareName}");
                }
                
                // Get URI for the Azure File Share service
                string serviceUri = $"https://{storageAccountName}.file.core.windows.net";
                Console.WriteLine($"[INFO] Connecting to {serviceUri}");
                
                // Use the existing credential from the Program class
                if (_credential == null)
                {
                    Console.ForegroundColor = ConsoleColor.Red;
                    Console.WriteLine("[ERROR] Failed to obtain authentication credential.");
                    Console.WriteLine("[ERROR] Please initialize authentication first.");
                    Console.ResetColor();
                    return;
                }
                
                // Create file share service with the credential
                Console.WriteLine("[INFO] Initializing FileShareService...");
                var fileShareService = new FileShareService(serviceUri, fileShareName, _credential);
                
                // Run the diagnostics
                Console.WriteLine("[INFO] Running File Share permission diagnostics...");
                await fileShareService.DiagnosePermissionsAsync();
                
                Console.WriteLine("\nPress any key to return to the settings menu...");
                Console.ReadKey();
            }
            catch (Exception ex)
            {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine($"[ERROR] An error occurred during permission diagnostics: {ex.Message}");
                Console.ResetColor();
                Utilities.Logger.LogError($"Error in RunFileSharePermissionDiagnostics: {ex}");
                
                Console.WriteLine("\nPress any key to return to the settings menu...");
                Console.ReadKey();
            }
        }
    }
}
