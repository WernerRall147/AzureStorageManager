using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace AzureStorageManager.Utilities
{
    public static class Logger
    {
        private static readonly object _lock = new object();
        private static string? _logFilePath = null;
        private static bool _initialized = false;

        public enum LogLevel
        {
            Info,
            Warning,
            Error,
            Debug
        }

        public static void Initialize(string? logDirectory = null)
        {
            if (_initialized) return;

            try
            {
                string directory = logDirectory ?? Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Logs");
                
                if (!Directory.Exists(directory))
                {
                    Directory.CreateDirectory(directory);
                }

                string timestamp = DateTime.Now.ToString("yyyyMMdd");
                _logFilePath = Path.Combine(directory, $"AzureStorageManager_{timestamp}.log");
                
                // Create the log file if it doesn't exist
                if (!File.Exists(_logFilePath))
                {
                    using (StreamWriter sw = File.CreateText(_logFilePath))
                    {
                        sw.WriteLine($"Log started at {DateTime.Now}");
                    }
                }

                _initialized = true;
                Log(LogLevel.Info, "Logger initialized");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to initialize logger: {ex.Message}");
            }
        }

        public static void Log(LogLevel level, string message)
        {
            if (!_initialized)
            {
                Initialize();
            }

            try
            {
                string logEntry = $"{DateTime.Now} [{level}] {message}";
                
                lock (_lock)
                {
                    if (_logFilePath != null)
                    {
                        File.AppendAllText(_logFilePath, logEntry + Environment.NewLine);
                    }
                }
                
                // For error and warning levels, also write to console
                if (level == LogLevel.Error || level == LogLevel.Warning)
                {
                    ConsoleColor originalColor = Console.ForegroundColor;
                    Console.ForegroundColor = level == LogLevel.Error ? ConsoleColor.Red : ConsoleColor.Yellow;
                    Console.WriteLine(logEntry);
                    Console.ForegroundColor = originalColor;
                }
            }
            catch
            {
                // Silently fail if logging fails
            }
        }

        public static string[] GetRecentLogs(int maxLines = 100)
        {
            if (!_initialized)
            {
                Initialize();
            }

            try
            {
                if (_logFilePath == null || !File.Exists(_logFilePath))
                {
                    return new[] { "No logs available." };
                }

                string[] allLines = File.ReadAllLines(_logFilePath);
                return allLines.Length <= maxLines
                    ? allLines
                    : allLines.Skip(allLines.Length - maxLines).ToArray();
            }
            catch (Exception ex)
            {
                return new[] { $"Error retrieving logs: {ex.Message}" };
            }
        }
        
        // Helper methods for specific log levels
        public static void LogInfo(string message)
        {
            Log(LogLevel.Info, message);
        }
        
        public static void LogWarning(string message)
        {
            Log(LogLevel.Warning, message);
        }
        
        public static void LogError(string message)
        {
            Log(LogLevel.Error, message);
        }
        
        public static void LogDebug(string message)
        {
            Log(LogLevel.Debug, message);
        }

        public static string[] GetLogFiles()
        {
            if (!_initialized)
            {
                Initialize();
            }

            try
            {
                if (_logFilePath == null)
                {
                    return new[] { "Log file path not initialized" };
                }
                
                string? directory = Path.GetDirectoryName(_logFilePath);
                if (directory == null)
                {
                    return new[] { "Could not determine log directory" };
                }
                
                return Directory.GetFiles(directory, "AzureStorageManager_*.log")
                    .OrderByDescending(f => File.GetLastWriteTime(f))
                    .ToArray();
            }
            catch (Exception ex)
            {
                return new[] { $"Error retrieving log files: {ex.Message}" };
            }
        }

        public static string[] ReadLogFile(string filePath, int maxLines = 200)
        {
            try
            {
                if (!File.Exists(filePath))
                {
                    return new[] { "Log file not found." };
                }

                string[] allLines = File.ReadAllLines(filePath);
                return allLines.Length <= maxLines
                    ? allLines
                    : allLines.Skip(allLines.Length - maxLines).ToArray();
            }
            catch (Exception ex)
            {
                return new[] { $"Error reading log file: {ex.Message}" };
            }
        }
    }
}
