using System.Net;
using System.Net.Http;
using Azure.Core;
using Azure.Core.Pipeline;
using Azure.Identity;
using Azure.Storage.Blobs;
using Azure.Storage.Files.Shares;
using Azure.Storage.Files.Shares.Models; 
using Microsoft.Extensions.Configuration;
using System;
using System.IO;
using System.Security.Cryptography.X509Certificates;
using System.Threading.Tasks;
using AzureStorageManager.Services;
using AzureStorageManager.Models;
using AzureStorageManager.Utilities;
using System.Windows.Forms;
using System.Collections.Generic;

namespace AzureStorageManager
{
    class Program
    {
        private static IConfiguration _config;
        private static TokenCredential _credential;
        private static HttpClient _httpClient;

        static async Task Main(string[] args)
        {
            // Load configuration
            _config = new ConfigurationBuilder()
                .SetBasePath(Directory.GetCurrentDirectory())
                .AddJsonFile("appsettings.json", optional: false)
                .AddEnvironmentVariables()
                .Build();

            bool exitRequested = false;

            while (!exitRequested)
            {
                Console.Clear();
                DisplayMainMenu();
                
                string choice = Console.ReadLine()?.Trim() ?? "";

                switch (choice)
                {
                    case "1":
                        await VerifyFileIntegrityAsync();
                        break;
                    case "2":
                        await GenerateMD5HashesAsync();
                        break;
                    case "3":
                        await CheckAndUpdateMetadataAsync();
                        break;
                    case "4":
                        await CopyFilesToAzureAsync();
                        break;
                    case "5":
                        await DownloadFilesFromAzureAsync();
                        break;
                    case "6":
                        await GenerateConsolidatedReportAsync();
                        break;
                    case "7":
                        ViewLogs();
                        break;
                    case "8":
                        ConfigureSettings();
                        break;
                    case "9":
                        DisplayHelp();
                        break;
                    case "10":
                        exitRequested = true;
                        Console.WriteLine("Exiting the application. Goodbye!");
                        break;
                    default:
                        Console.WriteLine("Invalid choice. Please try again.");
                        break;
                }

                if (!exitRequested)
                {
                    Console.WriteLine("\nPress Enter to return to the main menu...");
                    Console.ReadLine();
                }
            }
        }

        private static void DisplayMainMenu()
        {
            Console.WriteLine("=======================================");
            Console.WriteLine("        Azure Storage Manager Tool      ");
            Console.WriteLine("=======================================");
            Console.WriteLine();
            Console.WriteLine("Please select an option:");
            Console.WriteLine("1. Verify File Integrity");
            Console.WriteLine("2. Generate MD5 Hashes for Local Files");
            Console.WriteLine("3. Check and Update Azure Metadata");
            Console.WriteLine("4. Copy Files to Azure");
            Console.WriteLine("5. Download Files from Azure");
            Console.WriteLine("6. Generate Consolidated Report");
            Console.WriteLine("7. View Logs");
            Console.WriteLine("8. Settings");
            Console.WriteLine("9. Help");
            Console.WriteLine("10. Exit");
            Console.WriteLine("=======================================");
            Console.Write("Enter your choice: ");
        }

        private static void DisplayIntroduction()
        {
            Console.WriteLine("=======================================");
            Console.WriteLine("        Azure Storage Manager Tool      ");
            Console.WriteLine("=======================================");
            Console.WriteLine();
            Console.WriteLine("This tool helps you verify file integrity by comparing local files with those stored in Azure.");
            Console.WriteLine("It checks that files in Azure Blob Storage or File Shares match your local copies.");
            Console.WriteLine();
            Console.WriteLine("How to Use:");
            Console.WriteLine("1. Enter your Azure Storage Account name.");
            Console.WriteLine("2. Choose the storage type (Blob or File Share) and specify the container/share name.");
            Console.WriteLine("3. Enter the local directory path where your files are stored.");
            Console.WriteLine("The tool will compare each file's MD5 hash with the stored hash in Azure and");
            Console.WriteLine("generate a report showing any mismatches.");
            Console.WriteLine();
        }

        private static string GetDirectoryFromDialog()
        {
            using (var folderDialog = new FolderBrowserDialog())
            {
                folderDialog.Description = "Select the local directory for file operations";
                folderDialog.UseDescriptionForTitle = true;

                if (folderDialog.ShowDialog() == DialogResult.OK)
                {
                    return folderDialog.SelectedPath;
                }
                else
                {
                    Console.WriteLine("No directory selected. Operation cancelled.");
                    return string.Empty;
                }
            }
        }

        private static async Task InitializeAzureCredentialsAsync()
        {
            if (_credential != null)
            {
                // Credentials already initialized
                return;
            }

            string tenantId = _config["Azure:TenantId"] ?? "";
            string clientId = _config["Azure:ClientId"] ?? "";
            string thumbprint = _config["Azure:CertificateThumbprint"] ?? "";
            string clientSecret = _config["Azure:ClientSecret"] ?? "";

            // Load certificate from Windows Certificate Store
            Console.WriteLine("Loading certificate from Windows Certificate Store...");
            X509Certificate2? certificate = null;
            using (var store = new X509Store(StoreName.My, StoreLocation.CurrentUser))
            {
                store.Open(OpenFlags.ReadOnly);
                var certCollection = store.Certificates.Find(X509FindType.FindByThumbprint, thumbprint, validOnly: false);

                if (certCollection.Count > 0)
                {
                    certificate = certCollection[0];
                    Console.WriteLine($"Certificate loaded successfully: {certificate.Subject}");
                }
                else
                {
                    Console.WriteLine("Certificate not found. Will attempt fallback to client secret authentication.");
                }

                store.Close();
            }

            // Initialize credentials: try certificate first, then fallback to client secret
            if (certificate != null)
            {
                Console.WriteLine("Initializing ClientCertificateCredential...");
                _credential = new ClientCertificateCredential(tenantId, clientId, certificate);
            }
            else
            {
                if (string.IsNullOrEmpty(clientSecret))
                {
                    // If client secret isn't in appsettings, check environment variable
                    clientSecret = Environment.GetEnvironmentVariable("AZURE_CLIENT_SECRET") ?? "";
                }

                if (string.IsNullOrEmpty(clientSecret))
                {
                    Console.WriteLine("No client secret provided and certificate not found. Cannot authenticate.");
                    throw new ApplicationException("Authentication failed - no valid credentials provided.");
                }

                Console.WriteLine("Initializing ClientSecretCredential...");
                _credential = new ClientSecretCredential(tenantId, clientId, clientSecret);
            }

            // Ask if using a proxy
            Console.Write("Are you using a proxy? (yes/no): ");
            string? useProxyResponse = Console.ReadLine()?.Trim().ToLower();

            if (useProxyResponse == "yes")
            {
                Console.Write("Enter the proxy URL: ");
                string? proxyUrl = Console.ReadLine()?.Trim();

                Console.Write("Enter the proxy port: ");
                string? proxyPort = Console.ReadLine()?.Trim();

                if (!string.IsNullOrEmpty(proxyUrl) && !string.IsNullOrEmpty(proxyPort) && int.TryParse(proxyPort, out int port))
                {
                    var proxy = new WebProxy($"{proxyUrl}:{port}");
                    var httpClientHandler = new HttpClientHandler
                    {
                        Proxy = proxy,
                        UseProxy = true
                    };
                    _httpClient = new HttpClient(httpClientHandler);
                }
                else
                {
                    Console.WriteLine("Invalid proxy URL or port. Proceeding without proxy.");
                }
            }
        }

        private static async Task VerifyFileIntegrityAsync()
        {
            DisplayIntroduction();
            Console.WriteLine("=== Verify File Integrity ===\n");

            try
            {
                await InitializeAzureCredentialsAsync();
                
                // Prompt user for storage account details
                Console.Write("Enter your Azure Storage Account Name: ");
                string storageAccountName = Console.ReadLine() ?? "";

                Console.WriteLine("Choose Storage Type:");
                Console.WriteLine("1. Blob Storage");
                Console.WriteLine("2. File Share");
                string choice = Console.ReadLine() ?? "";

                string localDirectory = GetDirectoryFromDialog();
                if (string.IsNullOrEmpty(localDirectory))
                {
                    return;
                }

                if (string.IsNullOrEmpty(storageAccountName))
                {
                    Console.WriteLine("Storage account name is missing. Please check your input.");
                    return;
                }

                if (choice == "1")
                {
                    // Blob Storage
                    Console.Write("Enter your Azure Blob Container Name: ");
                    string blobContainerName = Console.ReadLine() ?? "";

                    Console.WriteLine("Connecting to Blob Storage...");
                    var blobClientOptions = new BlobClientOptions();
                    if (_httpClient != null)
                    {
                        blobClientOptions.Transport = new HttpClientTransport(_httpClient);
                    }
                    var blobServiceClient = new BlobServiceClient(new Uri($"https://{storageAccountName}.blob.core.windows.net"), _credential, blobClientOptions);

                    var blobStorageService = new BlobStorageService(blobServiceClient, blobContainerName);
                    string reportFileName = $"BlobStorageReport_{Path.GetFileName(localDirectory)}.csv";

                    await blobStorageService.ListAndVerifyBlobsAsync(localDirectory, reportFileName);
                    Console.WriteLine($"Verification complete. Report saved to: {reportFileName}");
                }
                else if (choice == "2")
                {
                    // File Share
                    Console.Write("Enter your Azure File Share Name: ");
                    string fileShareName = Console.ReadLine() ?? "";

                    Console.Write("Enter the folder path within the Azure File Share (e.g., folder\\subfolder): ");
                    string azureFolderPath = Console.ReadLine() ?? "";

                    Console.WriteLine("Connecting to File Share...");
                    var shareClientOptions = new ShareClientOptions();
                    if (_httpClient != null)
                    {
                        shareClientOptions.Transport = new HttpClientTransport(_httpClient);
                    }
                    shareClientOptions.AddPolicy(new FileRequestIntentPolicy(), HttpPipelinePosition.PerCall);

                    var shareServiceClient = new ShareServiceClient(new Uri($"https://{storageAccountName}.file.core.windows.net"), _credential, shareClientOptions);
                    var fileShareService = new FileShareService(shareServiceClient, fileShareName, azureFolderPath);

                    string reportFileName = $"FileShareReport_{Path.GetFileName(localDirectory)}.csv";
                    await fileShareService.ListAndVerifyFilesAsync(localDirectory, reportFileName);
                    Console.WriteLine($"Verification complete. Report saved to: {reportFileName}");
                }
                else
                {
                    Console.WriteLine("Invalid choice. Please select a valid option.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }        private static async Task GenerateMD5HashesAsync()
        {
            Console.WriteLine("=== Generate MD5 Hashes for Local Files ===\n");
            
            string localDirectory = GetDirectoryFromDialog();
            if (string.IsNullOrEmpty(localDirectory))
            {
                return;
            }

            try
            {
                Console.WriteLine("Generating MD5 hashes for all files in the selected directory...");
                
                // Create a list to hold file information
                var fileHashesList = new List<FileMetadata>();
                int processedCount = 0;
                int totalFiles = Directory.GetFiles(localDirectory, "*", SearchOption.AllDirectories).Length;
                
                // Process all files recursively
                foreach (var filePath in Directory.GetFiles(localDirectory, "*", SearchOption.AllDirectories))
                {
                    try
                    {
                        string relativePath = Path.GetRelativePath(localDirectory, filePath);
                        string md5Hash = FileHashUtility.CalculateMD5(filePath);
                        
                        fileHashesList.Add(new FileMetadata(
                            relativePath,
                            md5Hash,
                            "",  // No Azure hash since this is local only
                            "LocalOnly"
                        ));
                        
                        processedCount++;
                        if (processedCount % 10 == 0 || processedCount == totalFiles)
                        {
                            Console.Write($"\rProcessed {processedCount} of {totalFiles} files...");
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"\nError processing {filePath}: {ex.Message}");
                    }
                }
                
                // Generate timestamp for report filename
                string timestamp = DateTime.UtcNow.ToString("yyyyMMddHHmmss");
                string reportFileName = Path.Combine(localDirectory, $"LocalHashesReport_{timestamp}.csv");
                
                // Export to CSV
                CsvExporter.ExportToCsv(fileHashesList, reportFileName);
                
                Console.WriteLine($"\nHash generation complete. {processedCount} files processed.");
                Console.WriteLine($"Report saved to: {reportFileName}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }        private static async Task CheckAndUpdateMetadataAsync()
        {
            Console.WriteLine("=== Check and Update Azure Metadata ===\n");
            
            try
            {
                await InitializeAzureCredentialsAsync();
                
                // Prompt user for storage account details
                Console.Write("Enter your Azure Storage Account Name: ");
                string storageAccountName = Console.ReadLine() ?? "";

                if (string.IsNullOrEmpty(storageAccountName))
                {
                    Console.WriteLine("Storage account name is missing. Please check your input.");
                    return;
                }

                Console.WriteLine("Choose Storage Type:");
                Console.WriteLine("1. Blob Storage");
                Console.WriteLine("2. File Share");
                string choice = Console.ReadLine() ?? "";

                if (choice == "1")
                {
                    // Blob Storage
                    Console.Write("Enter your Azure Blob Container Name: ");
                    string blobContainerName = Console.ReadLine() ?? "";

                    string localDirectory = GetDirectoryFromDialog();
                    if (string.IsNullOrEmpty(localDirectory))
                    {
                        return;
                    }

                    Console.WriteLine("Connecting to Blob Storage...");
                    var blobClientOptions = new BlobClientOptions();
                    if (_httpClient != null)
                    {
                        blobClientOptions.Transport = new HttpClientTransport(_httpClient);
                    }
                    var blobServiceClient = new BlobServiceClient(new Uri($"https://{storageAccountName}.blob.core.windows.net"), _credential, blobClientOptions);
                    var containerClient = blobServiceClient.GetBlobContainerClient(blobContainerName);

                    // Check if container exists
                    bool containerExists = await containerClient.ExistsAsync();
                    if (!containerExists)
                    {
                        Console.WriteLine($"Container '{blobContainerName}' does not exist. Please check the container name.");
                        return;
                    }

                    Console.WriteLine("Checking blob metadata and updating missing MD5 hashes...");
                    
                    int totalBlobs = 0;
                    int updatedCount = 0;
                    int alreadyHadMD5 = 0;
                    
                    await foreach (var blobItem in containerClient.GetBlobsAsync())
                    {
                        totalBlobs++;
                        var blobClient = containerClient.GetBlobClient(blobItem.Name);
                        
                        // Get properties to check if MD5 metadata exists
                        var properties = await blobClient.GetPropertiesAsync();
                        bool hasMD5 = properties.Value.Metadata.TryGetValue("md5", out string md5Value);
                        
                        if (!hasMD5 || string.IsNullOrEmpty(md5Value))
                        {
                            // Get the content MD5 from the blob properties if available
                            string contentMD5 = "";
                            if (properties.Value.ContentHash.Length > 0)
                            {
                                contentMD5 = BitConverter.ToString(properties.Value.ContentHash).Replace("-", "").ToLowerInvariant();
                            }
                            
                            // If content MD5 is available, use it
                            if (!string.IsNullOrEmpty(contentMD5))
                            {
                                var metadata = new Dictionary<string, string>();
                                foreach (var item in properties.Value.Metadata)
                                {
                                    metadata[item.Key] = item.Value;
                                }
                                metadata["md5"] = contentMD5;
                                
                                await blobClient.SetMetadataAsync(metadata);
                                updatedCount++;
                                Console.WriteLine($"Updated MD5 metadata for: {blobItem.Name}");
                            }
                            else
                            {
                                Console.WriteLine($"Cannot update MD5 for {blobItem.Name}: Content MD5 not available");
                            }
                        }
                        else
                        {
                            alreadyHadMD5++;
                        }
                    }
                    
                    Console.WriteLine("\nMetadata check complete.");
                    Console.WriteLine($"Total blobs checked: {totalBlobs}");
                    Console.WriteLine($"Blobs already having MD5 metadata: {alreadyHadMD5}");
                    Console.WriteLine($"Blobs updated with MD5 metadata: {updatedCount}");
                }
                else if (choice == "2")
                {
                    Console.WriteLine("File Share metadata update is not yet supported. Check back in a future version.");
                }
                else
                {
                    Console.WriteLine("Invalid choice. Please select a valid option.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
                if (ex.InnerException != null)
                {
                    Console.WriteLine($"Inner Error: {ex.InnerException.Message}");
                }
            }
        }        private static async Task CopyFilesToAzureAsync()
        {
            Console.WriteLine("=== Copy Files to Azure ===\n");
            
            try
            {
                await InitializeAzureCredentialsAsync();
                
                // Prompt user for storage account details
                Console.Write("Enter your Azure Storage Account Name: ");
                string storageAccountName = Console.ReadLine() ?? "";

                if (string.IsNullOrEmpty(storageAccountName))
                {
                    Console.WriteLine("Storage account name is missing. Please check your input.");
                    return;
                }

                Console.WriteLine("Choose Storage Type:");
                Console.WriteLine("1. Blob Storage");
                Console.WriteLine("2. File Share");
                string choice = Console.ReadLine() ?? "";

                string localDirectory = GetDirectoryFromDialog();
                if (string.IsNullOrEmpty(localDirectory))
                {
                    return;
                }

                if (choice == "1")
                {
                    // Blob Storage
                    Console.Write("Enter your Azure Blob Container Name: ");
                    string blobContainerName = Console.ReadLine() ?? "";

                    Console.WriteLine("Connecting to Blob Storage...");
                    var blobClientOptions = new BlobClientOptions();
                    if (_httpClient != null)
                    {
                        blobClientOptions.Transport = new HttpClientTransport(_httpClient);
                    }
                    var blobServiceClient = new BlobServiceClient(new Uri($"https://{storageAccountName}.blob.core.windows.net"), _credential, blobClientOptions);
                    var containerClient = blobServiceClient.GetBlobContainerClient(blobContainerName);

                    // Check if container exists, create if it doesn't
                    bool containerExists = await containerClient.ExistsAsync();
                    if (!containerExists)
                    {
                        Console.WriteLine($"Container '{blobContainerName}' does not exist. Creating it now...");
                        await containerClient.CreateIfNotExistsAsync();
                        Console.WriteLine("Container created successfully.");
                    }

                    // Get all files in the directory
                    string[] files = Directory.GetFiles(localDirectory, "*", SearchOption.AllDirectories);
                    int totalFiles = files.Length;
                    int uploadedCount = 0;
                    int skippedCount = 0;
                    int errorCount = 0;

                    Console.WriteLine($"Found {totalFiles} files to upload.");
                    
                    foreach (string filePath in files)
                    {
                        try
                        {
                            // Get relative path for the blob name
                            string relativePath = Path.GetRelativePath(localDirectory, filePath);
                            // Replace backslashes with forward slashes for blob names
                            string blobName = relativePath.Replace('\\', '/');
                            
                            Console.Write($"\rUploading file {uploadedCount + 1} of {totalFiles}: {blobName}");
                            
                            // Create the blob client
                            var blobClient = containerClient.GetBlobClient(blobName);
                            
                            // Check if blob exists
                            bool blobExists = await blobClient.ExistsAsync();
                            
                            if (blobExists)
                            {
                                // Skip if exists
                                skippedCount++;
                                Console.Write($"\rSkipping existing blob: {blobName}".PadRight(80));
                                continue;
                            }

                            // Calculate MD5 hash before upload
                            string md5Hash = FileHashUtility.CalculateMD5(filePath);
                            
                            // Upload the file
                            using FileStream fileStream = new FileStream(filePath, FileMode.Open, FileAccess.Read);
                            await blobClient.UploadAsync(fileStream, true);
                            
                            // Set metadata with MD5 hash
                            var metadata = new Dictionary<string, string>
                            {
                                { "md5", md5Hash }
                            };
                            
                            await blobClient.SetMetadataAsync(metadata);
                            uploadedCount++;
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"\nError uploading {filePath}: {ex.Message}");
                            errorCount++;
                        }
                    }

                    Console.WriteLine("\n\nUpload Summary:");
                    Console.WriteLine($"Total files processed: {totalFiles}");
                    Console.WriteLine($"Successfully uploaded: {uploadedCount}");
                    Console.WriteLine($"Skipped (already exist): {skippedCount}");
                    Console.WriteLine($"Errors: {errorCount}");
                }
                else if (choice == "2")
                {
                    // File Share
                    Console.Write("Enter your Azure File Share Name: ");
                    string fileShareName = Console.ReadLine() ?? "";

                    Console.Write("Enter the folder path within the Azure File Share (e.g., folder\\subfolder): ");
                    string azureFolderPath = Console.ReadLine() ?? "";

                    Console.WriteLine("Connecting to File Share...");
                    var shareClientOptions = new ShareClientOptions();
                    if (_httpClient != null)
                    {
                        shareClientOptions.Transport = new HttpClientTransport(_httpClient);
                    }
                    shareClientOptions.AddPolicy(new FileRequestIntentPolicy(), HttpPipelinePosition.PerCall);

                    var shareServiceClient = new ShareServiceClient(new Uri($"https://{storageAccountName}.file.core.windows.net"), _credential, shareClientOptions);
                    var shareClient = shareServiceClient.GetShareClient(fileShareName);
                    
                    // Check if share exists, create if it doesn't
                    bool shareExists = await shareClient.ExistsAsync();
                    if (!shareExists)
                    {
                        Console.WriteLine($"File share '{fileShareName}' does not exist. Creating it now...");
                        await shareClient.CreateIfNotExistsAsync();
                        Console.WriteLine("File share created successfully.");
                    }
                    
                    // Create the directory structure if it doesn't exist
                    var directoryClient = shareClient.GetDirectoryClient(azureFolderPath);
                    await CreateDirectoryStructureAsync(directoryClient);
                    
                    // Get all files in the directory
                    string[] files = Directory.GetFiles(localDirectory, "*", SearchOption.AllDirectories);
                    int totalFiles = files.Length;
                    int uploadedCount = 0;
                    int skippedCount = 0;
                    int errorCount = 0;

                    Console.WriteLine($"Found {totalFiles} files to upload.");
                    
                    foreach (string filePath in files)
                    {
                        try
                        {
                            // Get relative path for the file name
                            string relativePath = Path.GetRelativePath(localDirectory, filePath);
                            
                            // Split the path into directory and file parts
                            string relativeDirPath = Path.GetDirectoryName(relativePath) ?? "";
                            string fileName = Path.GetFileName(filePath);
                            
                            // Combine with the Azure folder path
                            string azureFilePath = string.IsNullOrEmpty(relativeDirPath) 
                                ? azureFolderPath 
                                : Path.Combine(azureFolderPath, relativeDirPath).Replace('\\', '/');
                            
                            Console.Write($"\rUploading file {uploadedCount + 1} of {totalFiles}: {relativePath}");
                            
                            // Create subdirectory if needed
                            if (!string.IsNullOrEmpty(relativeDirPath))
                            {
                                var subDirClient = shareClient.GetDirectoryClient(azureFilePath);
                                await CreateDirectoryStructureAsync(subDirClient);
                            }
                            
                            // Get file client
                            var fileClient = shareClient.GetDirectoryClient(azureFilePath).GetFileClient(fileName);
                            
                            // Check if file exists
                            bool fileExists = await fileClient.ExistsAsync();
                            if (fileExists)
                            {
                                // Skip if exists
                                skippedCount++;
                                Console.Write($"\rSkipping existing file: {relativePath}".PadRight(80));
                                continue;
                            }
                            
                            // Upload the file
                            using FileStream fileStream = new FileStream(filePath, FileMode.Open, FileAccess.Read);
                            await fileClient.CreateAsync(fileStream.Length);
                            await fileClient.UploadAsync(fileStream);
                            
                            // Calculate and set MD5 hash in file properties
                            string md5Hash = FileHashUtility.CalculateMD5(filePath);
                            var metadata = new Dictionary<string, string>
                            {
                                { "md5", md5Hash }
                            };
                            
                            await fileClient.SetMetadataAsync(metadata);
                            uploadedCount++;
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"\nError uploading {filePath}: {ex.Message}");
                            errorCount++;
                        }
                    }

                    Console.WriteLine("\n\nUpload Summary:");
                    Console.WriteLine($"Total files processed: {totalFiles}");
                    Console.WriteLine($"Successfully uploaded: {uploadedCount}");
                    Console.WriteLine($"Skipped (already exist): {skippedCount}");
                    Console.WriteLine($"Errors: {errorCount}");
                }
                else
                {
                    Console.WriteLine("Invalid choice. Please select a valid option.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
                if (ex.InnerException != null)
                {
                    Console.WriteLine($"Inner Error: {ex.InnerException.Message}");
                }
            }
        }
        
        private static async Task CreateDirectoryStructureAsync(ShareDirectoryClient directoryClient)
        {
            try
            {
                await directoryClient.CreateIfNotExistsAsync();
                
                // If the path has multiple levels, ensure all parent directories exist
                string dirPath = directoryClient.Path;                        // If the path contains slashes, process each segment
                        if (dirPath.Contains('/'))
                        {
                            string[] pathSegments = dirPath.Split('/');
                            string currentPath = "";
                            
                            // Get the parent share client
                            var shareClient = directoryClient.Parent;
                            
                            for (int i = 0; i < pathSegments.Length; i++)
                            {
                                if (string.IsNullOrEmpty(pathSegments[i])) continue;
                                
                                currentPath += (currentPath == "" ? "" : "/") + pathSegments[i];
                                var parentDirClient = shareClient.GetDirectoryClient(currentPath);
                                await parentDirClient.CreateIfNotExistsAsync();
                            }
                        }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error creating directory structure: {ex.Message}");
                throw;
            }
        }        private static async Task DownloadFilesFromAzureAsync()
        {
            Console.WriteLine("=== Download Files from Azure ===\n");
            
            try
            {
                await InitializeAzureCredentialsAsync();
                
                // Prompt user for storage account details
                Console.Write("Enter your Azure Storage Account Name: ");
                string storageAccountName = Console.ReadLine() ?? "";

                if (string.IsNullOrEmpty(storageAccountName))
                {
                    Console.WriteLine("Storage account name is missing. Please check your input.");
                    return;
                }

                Console.WriteLine("Choose Storage Type:");
                Console.WriteLine("1. Blob Storage");
                Console.WriteLine("2. File Share");
                string choice = Console.ReadLine() ?? "";

                Console.WriteLine("Select the local directory where to download files:");
                string localDirectory = GetDirectoryFromDialog();
                if (string.IsNullOrEmpty(localDirectory))
                {
                    return;
                }

                if (choice == "1")
                {
                    // Blob Storage
                    Console.Write("Enter your Azure Blob Container Name: ");
                    string blobContainerName = Console.ReadLine() ?? "";
                    
                    Console.Write("Enter blob prefix filter (optional, press Enter for all): ");
                    string prefix = Console.ReadLine() ?? "";

                    Console.WriteLine("Connecting to Blob Storage...");
                    var blobClientOptions = new BlobClientOptions();
                    if (_httpClient != null)
                    {
                        blobClientOptions.Transport = new HttpClientTransport(_httpClient);
                    }
                    var blobServiceClient = new BlobServiceClient(new Uri($"https://{storageAccountName}.blob.core.windows.net"), _credential, blobClientOptions);
                    var containerClient = blobServiceClient.GetBlobContainerClient(blobContainerName);

                    // Check if container exists
                    bool containerExists = await containerClient.ExistsAsync();
                    if (!containerExists)
                    {
                        Console.WriteLine($"Container '{blobContainerName}' does not exist. Please check the container name.");
                        return;
                    }

                    // List all blobs with the given prefix
                    var blobItems = containerClient.GetBlobsAsync(prefix: prefix);
                    
                    int totalDownloaded = 0;
                    int skippedCount = 0;
                    int errorCount = 0;
                    int verificationFailures = 0;
                    
                    // Download each blob
                    await foreach (var blobItem in blobItems)
                    {
                        try
                        {
                            var blobClient = containerClient.GetBlobClient(blobItem.Name);
                            string filePath = Path.Combine(localDirectory, blobItem.Name);
                            
                            // Create directory structure if needed
                            string directoryPath = Path.GetDirectoryName(filePath);
                            if (!string.IsNullOrEmpty(directoryPath) && !Directory.Exists(directoryPath))
                            {
                                Directory.CreateDirectory(directoryPath);
                            }
                            
                            Console.Write($"\rDownloading: {blobItem.Name}".PadRight(80));
                            
                            // Check if file already exists
                            if (File.Exists(filePath))
                            {
                                skippedCount++;
                                Console.Write($"\rSkipping existing file: {blobItem.Name}".PadRight(80));
                                continue;
                            }
                            
                            // Download the blob
                            await blobClient.DownloadToAsync(filePath);
                            
                            // Get metadata for MD5 verification
                            var properties = await blobClient.GetPropertiesAsync();
                            bool hasMD5 = properties.Value.Metadata.TryGetValue("md5", out string remoteMD5);
                            
                            // Verify integrity if MD5 is available
                            if (hasMD5 && !string.IsNullOrEmpty(remoteMD5))
                            {
                                string localMD5 = FileHashUtility.CalculateMD5(filePath);
                                if (localMD5 != remoteMD5)
                                {
                                    Console.WriteLine($"\nIntegrity check failed for {blobItem.Name}");
                                    Console.WriteLine($"  - Azure MD5: {remoteMD5}");
                                    Console.WriteLine($"  - Local MD5: {localMD5}");
                                    verificationFailures++;
                                }
                            }
                            
                            totalDownloaded++;
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"\nError downloading {blobItem.Name}: {ex.Message}");
                            errorCount++;
                        }
                    }

                    Console.WriteLine("\n\nDownload Summary:");
                    Console.WriteLine($"Total files downloaded: {totalDownloaded}");
                    Console.WriteLine($"Skipped (already exist): {skippedCount}");
                    Console.WriteLine($"Errors: {errorCount}");
                    Console.WriteLine($"Integrity check failures: {verificationFailures}");
                }
                else if (choice == "2")
                {
                    // File Share
                    Console.Write("Enter your Azure File Share Name: ");
                    string fileShareName = Console.ReadLine() ?? "";

                    Console.Write("Enter the folder path within the Azure File Share (e.g., folder\\subfolder): ");
                    string azureFolderPath = Console.ReadLine() ?? "";

                    Console.WriteLine("Connecting to File Share...");
                    var shareClientOptions = new ShareClientOptions();
                    if (_httpClient != null)
                    {
                        shareClientOptions.Transport = new HttpClientTransport(_httpClient);
                    }
                    shareClientOptions.AddPolicy(new FileRequestIntentPolicy(), HttpPipelinePosition.PerCall);

                    var shareServiceClient = new ShareServiceClient(new Uri($"https://{storageAccountName}.file.core.windows.net"), _credential, shareClientOptions);
                    var shareClient = shareServiceClient.GetShareClient(fileShareName);
                    
                    // Check if share exists
                    bool shareExists = await shareClient.ExistsAsync();
                    if (!shareExists)
                    {
                        Console.WriteLine($"File share '{fileShareName}' does not exist. Please check the file share name.");
                        return;
                    }
                    
                    // Get the directory client
                    var directoryClient = shareClient.GetDirectoryClient(azureFolderPath);
                    bool dirExists = await directoryClient.ExistsAsync();
                    if (!dirExists)
                    {
                        Console.WriteLine($"Directory '{azureFolderPath}' does not exist in the file share. Please check the path.");
                        return;
                    }
                    
                    int totalDownloaded = 0;
                    int skippedCount = 0;
                    int errorCount = 0;
                    int verificationFailures = 0;
                      // Create stats object to track download progress
                    var stats = new DownloadStats();
                    
                    // Download files recursively
                    await DownloadDirectoryAsync(directoryClient, localDirectory, azureFolderPath, stats);
                    
                    // Get final counts from the stats object
                    totalDownloaded = stats.TotalDownloaded;
                    skippedCount = stats.SkippedCount;
                    errorCount = stats.ErrorCount;
                    verificationFailures = stats.VerificationFailures;

                    Console.WriteLine("\n\nDownload Summary:");
                    Console.WriteLine($"Total files downloaded: {totalDownloaded}");
                    Console.WriteLine($"Skipped (already exist): {skippedCount}");
                    Console.WriteLine($"Errors: {errorCount}");
                    Console.WriteLine($"Integrity check failures: {verificationFailures}");
                }
                else
                {
                    Console.WriteLine("Invalid choice. Please select a valid option.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
                if (ex.InnerException != null)
                {
                    Console.WriteLine($"Inner Error: {ex.InnerException.Message}");
                }
            }
        }
          private class DownloadStats
        {
            public int TotalDownloaded { get; set; }
            public int SkippedCount { get; set; }
            public int ErrorCount { get; set; }
            public int VerificationFailures { get; set; }
        }
        
        private static async Task DownloadDirectoryAsync(ShareDirectoryClient directoryClient, string localBaseDir, 
            string azureBasePath, DownloadStats stats)
        {            try
            {
                // List all files and directories in current directory
                await foreach (var item in directoryClient.GetFilesAndDirectoriesAsync())
                {
                    if (item.IsDirectory)
                    {
                        // Process subdirectory
                        var subDirClient = directoryClient.GetSubdirectoryClient(item.Name);
                        string nestedLocalDir = Path.Combine(localBaseDir, item.Name);
                        
                        // Create local directory if it doesn't exist
                        if (!Directory.Exists(nestedLocalDir))
                        {
                            Directory.CreateDirectory(nestedLocalDir);
                        }
                        
                        // Build the Azure path for this subdirectory
                        string nestedAzurePath = string.IsNullOrEmpty(azureBasePath) 
                            ? item.Name 
                            : $"{azureBasePath}/{item.Name}";
                        
                        // Recursively download files from subdirectory
                        await DownloadDirectoryAsync(subDirClient, nestedLocalDir, nestedAzurePath, stats);
                    }
                    else
                    {
                        // Process file
                        string localFilePath = Path.Combine(localBaseDir, item.Name);
                        var fileClient = directoryClient.GetFileClient(item.Name);
                        
                        Console.Write($"\rDownloading: {azureBasePath}/{item.Name}".PadRight(80));
                        
                        // Check if file already exists locally
                        if (File.Exists(localFilePath))
                        {
                            stats.SkippedCount++;
                            Console.Write($"\rSkipping existing file: {azureBasePath}/{item.Name}".PadRight(80));
                            continue;
                        }
                        
                        try
                        {
                            // Download file
                            await using (FileStream stream = File.Create(localFilePath))
                            {
                                var fileDownload = await fileClient.DownloadAsync();
                                await fileDownload.Value.Content.CopyToAsync(stream);
                            }
                            
                            // Get metadata for MD5 verification
                            var properties = await fileClient.GetPropertiesAsync();
                            bool hasMD5 = properties.Value.Metadata.TryGetValue("md5", out string remoteMD5);
                            
                            // Verify integrity if MD5 is available
                            if (hasMD5 && !string.IsNullOrEmpty(remoteMD5))
                            {
                                string localMD5 = FileHashUtility.CalculateMD5(localFilePath);
                                if (localMD5 != remoteMD5)
                                {
                                    Console.WriteLine($"\nIntegrity check failed for {azureBasePath}/{item.Name}");
                                    Console.WriteLine($"  - Azure MD5: {remoteMD5}");
                                    Console.WriteLine($"  - Local MD5: {localMD5}");
                                    stats.VerificationFailures++;
                                }
                            }
                            
                            stats.TotalDownloaded++;
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"\nError downloading {azureBasePath}/{item.Name}: {ex.Message}");
                            stats.ErrorCount++;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"\nError accessing directory {azureBasePath}: {ex.Message}");
                stats.ErrorCount++;
            }
        }        private static async Task GenerateConsolidatedReportAsync()
        {
            Console.WriteLine("=== Generate Consolidated Report ===\n");
            
            try
            {
                await InitializeAzureCredentialsAsync();
                
                // Prompt user for storage account details
                Console.Write("Enter your Azure Storage Account Name: ");
                string storageAccountName = Console.ReadLine() ?? "";

                if (string.IsNullOrEmpty(storageAccountName))
                {
                    Console.WriteLine("Storage account name is missing. Please check your input.");
                    return;
                }

                Console.WriteLine("Choose Storage Type:");
                Console.WriteLine("1. Blob Storage");
                Console.WriteLine("2. File Share");
                string choice = Console.ReadLine() ?? "";

                string localDirectory = GetDirectoryFromDialog();
                if (string.IsNullOrEmpty(localDirectory))
                {
                    return;
                }
                
                var allFileMetadata = new List<FileMetadata>();
                var timestamp = DateTime.UtcNow.ToString("yyyyMMddHHmmss");

                if (choice == "1")
                {
                    // Blob Storage
                    Console.Write("Enter your Azure Blob Container Name: ");
                    string blobContainerName = Console.ReadLine() ?? "";

                    Console.WriteLine("Connecting to Blob Storage...");
                    var blobClientOptions = new BlobClientOptions();
                    if (_httpClient != null)
                    {
                        blobClientOptions.Transport = new HttpClientTransport(_httpClient);
                    }
                    var blobServiceClient = new BlobServiceClient(new Uri($"https://{storageAccountName}.blob.core.windows.net"), _credential, blobClientOptions);
                    var containerClient = blobServiceClient.GetBlobContainerClient(blobContainerName);

                    // Check if container exists
                    bool containerExists = await containerClient.ExistsAsync();
                    if (!containerExists)
                    {
                        Console.WriteLine($"Container '{blobContainerName}' does not exist. Please check the container name.");
                        return;
                    }

                    // Process all local files first
                    Console.WriteLine("Processing local files...");
                    var localFiles = Directory.GetFiles(localDirectory, "*", SearchOption.AllDirectories);
                    var localFileDict = new Dictionary<string, string>(); // key: relativePath, value: md5Hash
                    
                    foreach (var filePath in localFiles)
                    {
                        string relativePath = Path.GetRelativePath(localDirectory, filePath);
                        // Normalize path separators to match Azure blob names
                        string normalizedPath = relativePath.Replace('\\', '/');
                        string md5Hash = FileHashUtility.CalculateMD5(filePath);
                        localFileDict[normalizedPath] = md5Hash;
                    }
                    
                    Console.WriteLine($"Found {localFileDict.Count} local files.");
                    
                    // Now process Azure blobs
                    Console.WriteLine("Processing Azure blobs...");
                    int processedCount = 0;
                    int missingLocalCount = 0;
                    int matchedCount = 0;
                    int mismatchCount = 0;
                    
                    // List all blobs in the container
                    await foreach (var blobItem in containerClient.GetBlobsAsync())
                    {
                        processedCount++;
                        if (processedCount % 10 == 0)
                        {
                            Console.Write($"\rProcessed {processedCount} blobs...");
                        }
                        
                        var blobClient = containerClient.GetBlobClient(blobItem.Name);
                        
                        // Get blob properties and metadata
                        var properties = await blobClient.GetPropertiesAsync();
                        properties.Value.Metadata.TryGetValue("md5", out string? remoteMD5);
                        
                        // Determine status by comparing with local file
                        if (localFileDict.TryGetValue(blobItem.Name, out string localMD5))
                        {
                            // Local file exists, compare hashes
                            if (!string.IsNullOrEmpty(remoteMD5) && remoteMD5 == localMD5)
                            {
                                allFileMetadata.Add(new FileMetadata(
                                    blobItem.Name,
                                    localMD5,
                                    remoteMD5,
                                    "Match"
                                ));
                                matchedCount++;
                            }
                            else
                            {
                                allFileMetadata.Add(new FileMetadata(
                                    blobItem.Name,
                                    localMD5,
                                    remoteMD5 ?? "(no MD5)",
                                    "Mismatch"
                                ));
                                mismatchCount++;
                            }
                            
                            // Remove from dictionary to track what's been processed
                            localFileDict.Remove(blobItem.Name);
                        }
                        else
                        {
                            // Local file doesn't exist
                            allFileMetadata.Add(new FileMetadata(
                                blobItem.Name,
                                "(not found)",
                                remoteMD5 ?? "(no MD5)",
                                "MissingLocal"
                            ));
                            missingLocalCount++;
                        }
                    }
                    
                    // Add any remaining local files (not in Azure)
                    foreach (var localFile in localFileDict)
                    {
                        allFileMetadata.Add(new FileMetadata(
                            localFile.Key,
                            localFile.Value,
                            "(not in Azure)",
                            "MissingAzure"
                        ));
                    }
                    
                    // Generate report filename
                    string reportFileName = Path.Combine(localDirectory, $"ConsolidatedReport_Blob_{timestamp}.csv");
                    CsvExporter.ExportToCsv(allFileMetadata, reportFileName);
                    
                    // Print summary
                    Console.WriteLine("\n\nReport Summary:");
                    Console.WriteLine($"Total files processed: {allFileMetadata.Count}");
                    Console.WriteLine($"Files matching: {matchedCount}");
                    Console.WriteLine($"Files with mismatched hashes: {mismatchCount}");
                    Console.WriteLine($"Files missing locally: {missingLocalCount}");
                    Console.WriteLine($"Files missing in Azure: {localFileDict.Count}");
                    Console.WriteLine($"Report saved to: {reportFileName}");
                }
                else if (choice == "2")
                {
                    // File Share
                    Console.Write("Enter your Azure File Share Name: ");
                    string fileShareName = Console.ReadLine() ?? "";

                    Console.Write("Enter the folder path within the Azure File Share (e.g., folder\\subfolder): ");
                    string azureFolderPath = Console.ReadLine() ?? "";

                    Console.WriteLine("Connecting to File Share...");
                    var shareClientOptions = new ShareClientOptions();
                    if (_httpClient != null)
                    {
                        shareClientOptions.Transport = new HttpClientTransport(_httpClient);
                    }
                    shareClientOptions.AddPolicy(new FileRequestIntentPolicy(), HttpPipelinePosition.PerCall);

                    var shareServiceClient = new ShareServiceClient(new Uri($"https://{storageAccountName}.file.core.windows.net"), _credential, shareClientOptions);
                    var shareClient = shareServiceClient.GetShareClient(fileShareName);
                    
                    // Check if share exists
                    bool shareExists = await shareClient.ExistsAsync();
                    if (!shareExists)
                    {
                        Console.WriteLine($"File share '{fileShareName}' does not exist. Please check the file share name.");
                        return;
                    }
                    
                    // Process all local files first
                    Console.WriteLine("Processing local files...");
                    var localFiles = Directory.GetFiles(localDirectory, "*", SearchOption.AllDirectories);
                    var localFileDict = new Dictionary<string, string>(); // key: relativePath, value: md5Hash
                    
                    foreach (var filePath in localFiles)
                    {
                        string relativePath = Path.GetRelativePath(localDirectory, filePath);
                        string md5Hash = FileHashUtility.CalculateMD5(filePath);
                        localFileDict[relativePath] = md5Hash;
                    }
                    
                    Console.WriteLine($"Found {localFileDict.Count} local files.");
                    
                    // Now process Azure files
                    Console.WriteLine("Processing Azure files...");
                    var directoryClient = shareClient.GetDirectoryClient(azureFolderPath);
                      // Create stats object to track progress
                    var stats = new ProcessDirectoryStats();
                    
                    // Process files recursively
                    await ProcessAzureDirectoryAsync(directoryClient, localFileDict, allFileMetadata, 
                        azureFolderPath, stats);
                        
                    // Get final counts from the stats object
                    int matchedCount = stats.MatchedCount;
                    int mismatchCount = stats.MismatchCount;
                    int missingLocalCount = stats.MissingLocalCount;
                    
                    // Add any remaining local files (not in Azure)
                    foreach (var localFile in localFileDict)
                    {
                        allFileMetadata.Add(new FileMetadata(
                            localFile.Key,
                            localFile.Value,
                            "(not in Azure)",
                            "MissingAzure"
                        ));
                    }
                    
                    // Generate report filename
                    string reportFileName = Path.Combine(localDirectory, $"ConsolidatedReport_FileShare_{timestamp}.csv");
                    CsvExporter.ExportToCsv(allFileMetadata, reportFileName);
                    
                    // Print summary
                    Console.WriteLine("\nReport Summary:");
                    Console.WriteLine($"Total files processed: {allFileMetadata.Count}");
                    Console.WriteLine($"Files matching: {matchedCount}");
                    Console.WriteLine($"Files with mismatched hashes: {mismatchCount}");
                    Console.WriteLine($"Files missing locally: {missingLocalCount}");
                    Console.WriteLine($"Files missing in Azure: {localFileDict.Count}");
                    Console.WriteLine($"Report saved to: {reportFileName}");
                }
                else
                {
                    Console.WriteLine("Invalid choice. Please select a valid option.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
                if (ex.InnerException != null)
                {
                    Console.WriteLine($"Inner Error: {ex.InnerException.Message}");
                }
            }
        }
          private class ProcessDirectoryStats
        {
            public int MatchedCount { get; set; }
            public int MismatchCount { get; set; }
            public int MissingLocalCount { get; set; }
        }
        
        private static async Task ProcessAzureDirectoryAsync(ShareDirectoryClient directoryClient, 
            Dictionary<string, string> localFileDict, List<FileMetadata> allFileMetadata,
            string currentPath, ProcessDirectoryStats stats)
        {            try
            {
                // Normalize the current path
                string normalizedPath = currentPath.Replace('/', '\\');
                int processedCount = 0;
                
                // List all files and directories in current directory
                await foreach (var item in directoryClient.GetFilesAndDirectoriesAsync())
                {
                    processedCount++;
                    if (processedCount % 10 == 0)
                    {
                        Console.Write($"\rProcessed {processedCount} items in {normalizedPath}...");
                    }
                    
                    if (item.IsDirectory)
                    {
                        // Process subdirectory
                        var subDirClient = directoryClient.GetSubdirectoryClient(item.Name);
                        string nextPath = string.IsNullOrEmpty(currentPath) ? item.Name : $"{currentPath}/{item.Name}";
                        await ProcessAzureDirectoryAsync(subDirClient, localFileDict, allFileMetadata, 
                            nextPath, stats);
                    }
                    else
                    {
                        // Process file
                        var fileClient = directoryClient.GetFileClient(item.Name);
                        
                        // Get file properties and metadata
                        var properties = await fileClient.GetPropertiesAsync();
                        properties.Value.Metadata.TryGetValue("md5", out string? remoteMD5);
                        
                        // Determine the relative path for comparison with local files
                        string relativePath = string.IsNullOrEmpty(currentPath) 
                            ? item.Name 
                            : $"{currentPath.Replace('/', '\\')}/{item.Name}".Replace('/', '\\');
                        
                        // Check if the file exists locally
                        if (localFileDict.TryGetValue(relativePath, out string localMD5))
                        {
                            // Local file exists, compare hashes
                            if (!string.IsNullOrEmpty(remoteMD5) && remoteMD5 == localMD5)
                            {
                                allFileMetadata.Add(new FileMetadata(
                                    relativePath,
                                    localMD5,
                                    remoteMD5,
                                    "Match"
                                ));
                                stats.MatchedCount++;
                            }
                            else
                            {
                                allFileMetadata.Add(new FileMetadata(
                                    relativePath,
                                    localMD5,
                                    remoteMD5 ?? "(no MD5)",
                                    "Mismatch"
                                ));
                                stats.MismatchCount++;
                            }
                            
                            // Remove from dictionary to track what's been processed
                            localFileDict.Remove(relativePath);
                        }
                        else
                        {
                            // Local file doesn't exist
                            allFileMetadata.Add(new FileMetadata(
                                relativePath,
                                "(not found)",
                                remoteMD5 ?? "(no MD5)",
                                "MissingLocal"
                            ));
                            stats.MissingLocalCount++;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"\nError processing directory {currentPath}: {ex.Message}");
            }
        }        private static void ViewLogs()
        {
            Console.WriteLine("=== View Logs ===\n");
            
            try
            {
                // Initialize logger if not already initialized
                Utilities.Logger.Initialize();
                
                // Show log options
                Console.WriteLine("1. View Recent Logs");
                Console.WriteLine("2. View Log Files");
                Console.WriteLine("3. Back to Main Menu");
                Console.Write("Enter your choice: ");
                
                string choice = Console.ReadLine()?.Trim() ?? "";
                
                switch (choice)
                {
                    case "1":
                        // View recent logs
                        Console.WriteLine("\nRecent Log Entries:");
                        Console.WriteLine("---------------------------------------");
                        string[] recentLogs = Utilities.Logger.GetRecentLogs(50);
                        
                        if (recentLogs.Length == 0)
                        {
                            Console.WriteLine("No log entries found.");
                        }
                        else
                        {
                            foreach (var log in recentLogs)
                            {
                                if (log.Contains("[Error]"))
                                {
                                    Console.ForegroundColor = ConsoleColor.Red;
                                    Console.WriteLine(log);
                                    Console.ResetColor();
                                }
                                else if (log.Contains("[Warning]"))
                                {
                                    Console.ForegroundColor = ConsoleColor.Yellow;
                                    Console.WriteLine(log);
                                    Console.ResetColor();
                                }
                                else
                                {
                                    Console.WriteLine(log);
                                }
                            }
                        }
                        break;
                        
                    case "2":
                        // List log files
                        string[] logFiles = Utilities.Logger.GetLogFiles();
                        
                        if (logFiles.Length == 0)
                        {
                            Console.WriteLine("No log files found.");
                            return;
                        }
                        
                        Console.WriteLine("\nAvailable Log Files:");
                        Console.WriteLine("---------------------------------------");
                        
                        for (int i = 0; i < logFiles.Length; i++)
                        {
                            string filename = Path.GetFileName(logFiles[i]);
                            DateTime lastWriteTime = File.GetLastWriteTime(logFiles[i]);
                            Console.WriteLine($"{i + 1}. {filename} - Last updated: {lastWriteTime}");
                        }
                        
                        Console.Write("\nEnter file number to view (or 0 to go back): ");
                        if (int.TryParse(Console.ReadLine(), out int fileIndex) && fileIndex > 0 && fileIndex <= logFiles.Length)
                        {
                            string selectedFile = logFiles[fileIndex - 1];
                            
                            Console.WriteLine($"\nShowing log file: {Path.GetFileName(selectedFile)}");
                            Console.WriteLine("---------------------------------------");
                            
                            string[] logContents = Utilities.Logger.ReadLogFile(selectedFile);
                            foreach (var log in logContents)
                            {
                                if (log.Contains("[Error]"))
                                {
                                    Console.ForegroundColor = ConsoleColor.Red;
                                    Console.WriteLine(log);
                                    Console.ResetColor();
                                }
                                else if (log.Contains("[Warning]"))
                                {
                                    Console.ForegroundColor = ConsoleColor.Yellow;
                                    Console.WriteLine(log);
                                    Console.ResetColor();
                                }
                                else
                                {
                                    Console.WriteLine(log);
                                }
                            }
                        }
                        break;
                        
                    case "3":
                        return;
                        
                    default:
                        Console.WriteLine("Invalid choice.");
                        break;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }

